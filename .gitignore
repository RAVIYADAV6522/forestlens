__pycache__/
*.py[cod]
.venv/
.env
.DS_Store

# Run artefacts and large imagery stay out of git
outputs/*
!outputs/.gitkeep
# Sample scenes ARE committed: the deployed demo needs them, and they are small
# crops (~1.5 MB) with provenance sidecars. Big rasters stay out.
data/sample/*
!data/sample/.gitkeep
!data/sample/PROVENANCE.md
!data/sample/*.tif
!data/sample/*.provenance.json

# pytorch-lightning writes these into the working directory on every inference run
lightning_logs/

# Model weights
*.pt
*.pth
checkpoints/
.pytest_cache/
